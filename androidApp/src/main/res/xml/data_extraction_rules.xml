<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude local SQLite database containing chats and vault data from cloud backup to protect user privacy -->
        <exclude domain="database" path="bubble.db" />
        <exclude domain="database" path="bubble.db-shm" />
        <exclude domain="database" path="bubble.db-wal" />
    </cloud-backup>
    <device-transfer>
        <!-- Allow direct encrypted device-to-device migration when user changes phone -->
        <include domain="database" path="bubble.db" />
        <include domain="database" path="bubble.db-shm" />
        <include domain="database" path="bubble.db-wal" />
    </device-transfer>
</data-extraction-rules>
